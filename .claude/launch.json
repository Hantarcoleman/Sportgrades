{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static-powershell",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".claude/serve.ps1",
        "-Root",
        "client"
      ],
      "port": 8000,
      "autoPort": true
    }
  ]
}
